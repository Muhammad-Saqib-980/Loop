DATABASE_URL=postgres://todo:todo@localhost:5432/todo_dev
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Email (Resend). Leave RESEND_API_KEY empty to run without an email provider;
# verification and password-reset emails are then unavailable, and
# REQUIRE_EMAIL_VERIFICATION must be false or the server refuses to start.
RESEND_API_KEY=replace-with-your-resend-api-key
EMAIL_FROM=Loop <noreply@example.com>
# "true" (default): new accounts must verify their email before logging in.
# "false": accounts can log in right after registering.
REQUIRE_EMAIL_VERIFICATION=true
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
PORT=4000
NODE_ENV=development
# Set to "true" when deployed behind a reverse proxy (e.g. Render, Fly, Railway)
# so express-rate-limit and req.ip see the real client address, not the proxy's.
TRUST_PROXY=true
